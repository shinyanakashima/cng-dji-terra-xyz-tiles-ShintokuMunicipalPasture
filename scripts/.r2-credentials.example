# R2 認証情報のテンプレート。
# このファイル(.example)はコミット可。実ファイルは「.r2-credentials」にコピーして使う:
#     Copy-Item scripts\.r2-credentials.example scripts\.r2-credentials
# 実ファイル「.r2-credentials」は .gitignore 済みでコミットされない。秘密キーはそちらに書く。
#
# 形式: KEY=VALUE （# 始まりはコメント、前後の空白と引用符は無視される）
# 環境変数が既にセットされていれば、そちらが優先される。

R2_ACCOUNT_ID=PASTE_YOUR_R2_ACCOUNT_ID
AWS_ACCESS_KEY_ID=PASTE_YOUR_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=PASTE_YOUR_R2_SECRET_ACCESS_KEY
